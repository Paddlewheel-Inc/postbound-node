{
  "name": "postbound",
  "version": "0.1.0",
  "packageManager": "pnpm@11.9.0",
  "description": "Node.js library for the Postbound API",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "sideEffects": false,
  "files": [
    "dist/**"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm,cjs --dts",
    "check": "pnpm lint && pnpm typecheck && pnpm check:pinned && pnpm check:source && pnpm build && pnpm check:package",
    "check:package": "node scripts/verify-build.mjs && publint && attw --pack .",
    "check:pinned": "node scripts/check-pinned.mjs",
    "check:source": "node scripts/check-source.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Paddlewheel-Inc/postbound-node.git"
  },
  "author": "Paddlewheel Inc.",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Paddlewheel-Inc/postbound-node/issues"
  },
  "homepage": "https://github.com/Paddlewheel-Inc/postbound-node#readme",
  "peerDependencies": {
    "@react-email/render": "*"
  },
  "peerDependenciesMeta": {
    "@react-email/render": {
      "optional": true
    }
  },
  "dependencies": {
    "standardwebhooks": "1.1.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.6.9",
    "@react-email/render": "2.3.1",
    "@types/node": "26.6.11",
    "@types/react": "19.3.3",
    "pkg-pr-new": "0.0.94",
    "publint": "0.3.25",
    "react": "19.3.1",
    "tsdown": "0.23.7",
    "typescript": "7.0.2"
  }
}
